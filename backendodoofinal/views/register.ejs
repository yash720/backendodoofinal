<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Register' }) %>
</head>
<body>
  <%- include('partials/nav') %>

  <div class="container-narrow">
    <div class="card">
      <h1>Create an Account</h1>
      <p class="subtitle">Register as a student, company, or TPO.</p>

      <form id="registerForm">
        <div>
          <label for="role">I am a</label>
          <select id="role" name="role" required>
            <option value="">Select role…</option>
            <option value="student">Student</option>
            <option value="company">Company</option>
            <option value="tpo">TPO</option>
          </select>
        </div>

        <div class="field-row">
          <div>
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" required>
          </div>
          <div>
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required>
          </div>
        </div>

        <div class="field-row">
          <div>
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required>
          </div>
          <div>
            <label for="phone">Phone</label>
            <input type="text" id="phone" name="phone">
          </div>
        </div>

        <div>
          <label for="address">Address</label>
          <input type="text" id="address" name="address">
        </div>

        <div id="studentFields" class="hidden">
          <div class="field-row">
            <div>
              <label for="rollNumber">Roll Number</label>
              <input type="text" id="rollNumber" name="rollNumber">
            </div>
            <div>
              <label for="branch">Branch</label>
              <input type="text" id="branch" name="branch">
            </div>
          </div>
          <div>
            <label for="graduationYear">Graduation Year</label>
            <input type="number" id="graduationYear" name="graduationYear" min="2000" max="2100">
          </div>
        </div>

        <div id="companyFields" class="hidden">
          <div class="field-row">
            <div>
              <label for="HRcontact">HR Contact Name</label>
              <input type="text" id="HRcontact" name="HRcontact">
            </div>
            <div>
              <label for="contactNumberCompany">Contact Number</label>
              <input type="text" id="contactNumberCompany" name="contactNumberCompany">
            </div>
          </div>
        </div>

        <div id="tpoFields" class="hidden">
          <div class="field-row">
            <div>
              <label for="instituteName">Institute Name</label>
              <input type="text" id="instituteName" name="instituteName">
            </div>
            <div>
              <label for="contactNumberTpo">Contact Number</label>
              <input type="text" id="contactNumberTpo" name="contactNumberTpo">
            </div>
          </div>
        </div>

        <button type="submit" id="registerBtn">Create Account</button>
        <div id="registerMsg" class="msg"></div>
      </form>

      <p class="text-muted" style="margin-top:16px">Already have an account? <a href="/login">Login here</a></p>
    </div>
  </div>

  <script>
    const roleSelect = document.getElementById('role');
    roleSelect.addEventListener('change', function () {
      document.getElementById('studentFields').classList.toggle('hidden', this.value !== 'student');
      document.getElementById('companyFields').classList.toggle('hidden', this.value !== 'company');
      document.getElementById('tpoFields').classList.toggle('hidden', this.value !== 'tpo');
    });

    document.getElementById('registerForm').addEventListener('submit', async function (e) {
      e.preventDefault();
      const btn = document.getElementById('registerBtn');
      const msgEl = document.getElementById('registerMsg');
      btn.disabled = true;

      const role = roleSelect.value;
      const payload = {
        role,
        name: document.getElementById('name').value.trim(),
        email: document.getElementById('email').value.trim(),
        password: document.getElementById('password').value,
        phone: document.getElementById('phone').value.trim(),
        address: document.getElementById('address').value.trim()
      };

      if (role === 'student') {
        payload.rollNumber = document.getElementById('rollNumber').value.trim();
        payload.branch = document.getElementById('branch').value.trim();
        payload.graduationYear = document.getElementById('graduationYear').value;
      } else if (role === 'company') {
        payload.HRcontact = document.getElementById('HRcontact').value.trim();
        payload.contactNumber = document.getElementById('contactNumberCompany').value.trim();
      } else if (role === 'tpo') {
        payload.instituteName = document.getElementById('instituteName').value.trim();
        payload.contactNumber = document.getElementById('contactNumberTpo').value.trim();
      }

      try {
        if (!role) throw new Error('Please select a role');
        await apiFetch('/auth/register', { method: 'POST', body: JSON.stringify(payload) });
        showMsg(msgEl, 'Account created! Redirecting to login…', false);
        setTimeout(() => (window.location.href = '/login'), 1200);
      } catch (err) {
        showMsg(msgEl, (err.data && (err.data.message || err.data.error)) || err.message, true);
      } finally {
        btn.disabled = false;
      }
    });
  </script>
</body>
</html>
