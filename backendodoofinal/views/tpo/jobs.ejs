<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Manage Jobs' }) %>
</head>
<body>
  <%- include('../partials/nav') %>

  <div class="container">
    <h1>Manage Jobs</h1>
    <p class="subtitle">Edit or remove any job posting on the platform. New postings are created by companies and reviewed under <a href="/tpo/job-approval">Job Approval</a>.</p>
    <div id="jobsList" class="loading">Loading…</div>
  </div>

  <script>
    function editForm(job) {
      return `
        <div id="editArea_${job.id}" style="margin-top:10px;border-top:1px solid var(--border);padding-top:10px;display:none">
          <div class="field-row">
            <div>
              <label>Title</label>
              <input type="text" id="title_${job.id}" value="${escapeHtml(job.title)}">
            </div>
            <div>
              <label>Location</label>
              <input type="text" id="location_${job.id}" value="${escapeHtml(job.location)}">
            </div>
          </div>
          <div class="field-row">
            <div>
              <label>Package</label>
              <input type="number" id="package_${job.id}" value="${job.package ?? ''}">
            </div>
            <div>
              <label>Status</label>
              <select id="status_${job.id}">
                <option value="Open" ${job.status === 'Open' ? 'selected' : ''}>Open</option>
                <option value="Closed" ${job.status === 'Closed' ? 'selected' : ''}>Closed</option>
                <option value="On Hold" ${job.status === 'On Hold' ? 'selected' : ''}>On Hold</option>
              </select>
            </div>
          </div>
          <button class="btn-small" onclick="saveJob('${job.id}')">Save</button>
          <div id="editMsg_${job.id}" class="msg"></div>
        </div>
      `;
    }

    function toggleEdit(jobId) {
      const el = document.getElementById('editArea_' + jobId);
      el.style.display = el.style.display === 'none' ? 'block' : 'none';
    }

    async function saveJob(jobId) {
      const msgEl = document.getElementById('editMsg_' + jobId);
      try {
        const payload = {
          title: document.getElementById('title_' + jobId).value.trim(),
          location: document.getElementById('location_' + jobId).value.trim(),
          package: Number(document.getElementById('package_' + jobId).value),
          status: document.getElementById('status_' + jobId).value
        };
        await apiFetch('/tpo/jobs/' + jobId, { method: 'PUT', body: JSON.stringify(payload) });
        showMsg(msgEl, 'Saved!', false);
        setTimeout(loadJobs, 600);
      } catch (err) {
        showMsg(msgEl, (err.data && (err.data.message || err.data.error)) || err.message, true);
      }
    }

    async function deleteJob(jobId) {
      if (!confirm('Delete this job posting? This cannot be undone.')) return;
      try {
        await apiFetch('/tpo/jobs/' + jobId, { method: 'DELETE' });
        loadJobs();
      } catch (err) {
        alert('Failed to delete: ' + err.message);
      }
    }

    async function loadJobs() {
      const el = document.getElementById('jobsList');
      el.innerHTML = '<div class="loading">Loading…</div>';
      try {
        const [pending, approved, rejected] = await Promise.all([
          apiFetch('/tpo/job-approval/pending'),
          apiFetch('/tpo/job-approval/approved'),
          apiFetch('/tpo/job-approval/rejected')
        ]);
        const jobs = [
          ...(pending.data.jobs || []),
          ...(approved.data.jobs || []),
          ...(rejected.data.jobs || [])
        ];
        if (!jobs.length) {
          el.innerHTML = '<div class="empty-state">No jobs on the platform yet.</div>';
          return;
        }
        el.innerHTML = jobs.map(job => `
          <div class="card">
            <div class="card-row">
              <div>
                <strong>${escapeHtml(job.title)}</strong><br>
                <span class="text-muted">${escapeHtml(job.company.name)} · ${escapeHtml(job.location)} · ${fmtMoney(job.package)}</span>
              </div>
              <div>
                <span class="badge">${escapeHtml(job.status || '-')}</span>
              </div>
            </div>
            <div class="btn-row">
              <button class="btn-small btn-secondary" onclick="toggleEdit('${job.id}')">Edit</button>
              <button class="btn-small btn-danger" onclick="deleteJob('${job.id}')">Delete</button>
            </div>
            ${editForm(job)}
          </div>
        `).join('');
      } catch (err) {
        el.innerHTML = `<div class="msg error" style="display:block">Failed to load jobs: ${escapeHtml(err.message)}</div>`;
      }
    }

    requireAuth('tpo');
    loadJobs();
  </script>
</body>
</html>
